local function CreateSlider(parent, text, min, max, default, callback)
    local frame = Instance.new("Frame", parent)
    frame.Size = UDim2.new(1, -6, 0, 42)
    frame.BackgroundColor3 = Color3.fromRGB(28, 15, 45)
    frame.BorderSizePixel = 0
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 6)

    local label = Instance.new("TextLabel", frame)
    label.Size = UDim2.new(0.72, 0, 0, 18)
    label.Position = UDim2.fromOffset(8, 3)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = Color3.fromRGB(220, 190, 255)
    label.TextSize = 11
    label.Font = Enum.Font.Gotham
    label.TextXAlignment = Enum.TextXAlignment.Left

    local vl = Instance.new("TextLabel", frame)
    vl.Size = UDim2.new(0.26, 0, 0, 18)
    vl.Position = UDim2.new(0.74, -6, 0, 3)
    vl.BackgroundTransparency = 1
    vl.Text = default >= 1000 and tostring(math.floor(default)) or string.format("%.2f", default)
    vl.TextColor3 = Color3.fromRGB(180, 130, 255)
    vl.TextSize = 11
    vl.Font = Enum.Font.GothamBold
    vl.TextXAlignment = Enum.TextXAlignment.Right

    local barBg = Instance.new("Frame", frame)
    barBg.Size = UDim2.new(1, -16, 0, 7)
    barBg.Position = UDim2.fromOffset(8, 27)
    barBg.BackgroundColor3 = Color3.fromRGB(50, 30, 70)
    barBg.BorderSizePixel = 0
    Instance.new("UICorner", barBg).CornerRadius = UDim.new(1, 0)

    local fill = Instance.new("Frame", barBg)
    fill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
    fill.BackgroundColor3 = PURPLE
    fill.BorderSizePixel = 0
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

    local dragging = false
    local function update(input)
        local pos = math.clamp((input.Position.X - barBg.AbsolutePosition.X) / math.max(barBg.AbsoluteSize.X, 1), 0, 1)
        local value = min + (max - min) * pos
        fill.Size = UDim2.new(pos, 0, 1, 0)
        vl.Text = value >= 1000 and tostring(math.floor(value)) or string.format("%.2f", value)
        callback(value)
    end

    barBg.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true; update(input)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
            update(input)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    return frame
end

