    if ok and hwid and hwid ~= "" then return hwid end
    return "RBX-" .. tostring(_LP.UserId) .. "-" .. tostring(game.PlaceId)
end

local function downloadKeys()
    local req = (syn and syn.request) or (http and http.request) or http_request or request
    if not req then return nil end
    local ok, response = pcall(function()
        return req({ Url = KEYS_URL, Method = "GET" })
    end)
    if not ok or not response or not response.Body then return nil end
    return response.Body
end

local function parseKeys(content)
    local free, vip, admin = {}, {}, {}
    if not content then return free, vip, admin end
    for line in content:gmatch("[^\r\n]+") do
        line = line:gsub("^%s+", ""):gsub("%s+$", "")
        local adminKey = line:match("^admin:(.+)$")
        if adminKey then
            admin[adminKey] = true
        else
            local freeList = line:match("^free:(.+)$")
            if freeList then
                for num in freeList:gmatch("%d+") do free[num] = true end
            else
                local vipBody = line:match("^vip:(.+)$")
                if vipBody then
                    local keysPart, hoursStr = vipBody:match("^(.-):(%d+)$")
                    if keysPart and hoursStr then
                        local hours = tonumber(hoursStr)
                        for num in keysPart:gmatch("%d+") do vip[num] = hours end
                    else
                        for num in vipBody:gmatch("%d+") do vip[num] = 24 end
                    end
                end
            end
        end
    end
    return free, vip, admin
end

local function checkKey(key, freeList, vipList, adminList)
    key = key:gsub("^%s+", ""):gsub("%s+$", "")
    if adminList and adminList[key] then
        return { type = "admin", label = "👑 ADMIN (MEGA)", key = key, hours = nil }
    end
    local num = key:match("%d+")
    if not num then return nil end
    if vipList[num] then
        return { type = "vip", label = "💎 VIP (" .. vipList[num] .. "ч)", number = num, hours = vipList[num] }
    end
    if freeList[num] then
        return { type = "free", label = "🎁 FREE (24ч)", number = num, hours = 24 }
    end
    return nil
end

