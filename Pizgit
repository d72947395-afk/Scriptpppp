-- AIM HELPERS
-- ============================================================
local _AlessiumAim = { Target = nil, Direction = nil }

local function GetTargetPart(character)
    if not character then return nil end
    if Config.Aim.Part == "Head" then
        local head = character:FindFirstChild("Head")
        if head and head:IsA("BasePart") then return head end
    end
    return character:FindFirstChild("UpperTorso")
        or character:FindFirstChild("Torso")
        or character:FindFirstChild("HumanoidRootPart")
end

local function IsEnemy(player)
    if not player or player == LocalPlayer then return false end
    if Config.Aim.TeamCheck then
        if LocalPlayer.Team and player.Team and LocalPlayer.Team == player.Team then return false end
    end
    return true
end

local function CanSee(character, part, cam)
    if not Config.Aim.VisibleCheck then return true end
    local origin = cam.CFrame.Position
    local direction = part.Position - origin
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local ignored = {}
    if LocalPlayer.Character then table.insert(ignored, LocalPlayer.Character) end
    params.FilterDescendantsInstances = ignored
    params.IgnoreWater = true
    local result = workspace:Raycast(origin, direction, params)
    if not result then return true end
    return result.Instance:IsDescendantOf(character)
end

local function IsValidTarget(player, cam)
    if not player or not IsEnemy(player) then return false end
    local char = player.Character
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    local part = GetTargetPart(char)
    if not part then return false end
    local screen, visible = cam:WorldToViewportPoint(part.Position)
    if not visible or screen.Z <= 0 then return false end
    local center = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
    local dist = (Vector2.new(screen.X, screen.Y) - center).Magnitude
    if dist > Config.Aim.FOV then return false end
    return CanSee(char, part, cam)
end

local function FindBestTarget(cam)
    local best, bestDist = nil, Config.Aim.FOV
    local center = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)

    for _, player in ipairs(Players:GetPlayers()) do
        if IsEnemy(player) then
            local char = player.Character
            if char then
                local hum = char:FindFirstChildOfClass("Humanoid")
                local part = GetTargetPart(char)
                if hum and hum.Health > 0 and part then
                    local screen, visible = cam:WorldToViewportPoint(part.Position)
                    if visible and screen.Z > 0 then
                        local d = (Vector2.new(screen.X, screen.Y) - center).Magnitude
                        if d <= bestDist then
                            if CanSee(char, part, cam) then
                                bestDist = d
                                best = player
                            end
                        end
                    end
                end
            end
        end
    end
    return best
end

local function UpdateAim()
    local cam = Workspace.CurrentCamera
    if not cam then return end

    local active = false
    if Config.Aim.Enabled then
        if Config.Aim.Mode == "Mobile" and Config.Aim.MobileAuto then active = true
        elseif Config.Aim.Mode == "Mobile" then active = aimButtonActive
        elseif Config.Aim.Mode == "PC" then active = aimKeyActive
        elseif Config.Aim.Mode == "Both" then
            active = aimKeyActive or aimButtonActive
            if Config.Aim.MobileAuto and IS_MOBILE then active = true end
        end
    end

    if not active then
        _AlessiumAim.Target = nil
        _AlessiumAim.Direction = nil
        return
    end

    local current = _AlessiumAim.Target
    if Config.Aim.TargetLock and current and IsValidTarget(current, cam) then
        -- держим
    else
        current = FindBestTarget(cam)
    end

    if not current then
        _AlessiumAim.Target = nil
        _AlessiumAim.Direction = nil
        return
    end

    local part = GetTargetPart(current.Character)
    if not part then return end

    _AlessiumAim.Target = current
    local offset = part.Position - cam.CFrame.Position
    if offset.Magnitude > 0.001 then
        _AlessiumAim.Direction = offset.Unit
    end
end

local function UpdateCameraAim()
    local cam = Workspace.CurrentCamera
    if not cam or not Config.Aim.Enabled then return end
    local direction = _AlessiumAim.Direction
    if not direction then return end

    local strength = math.clamp(Config.Aim.Smoothness, 0.01, 1)
    if not IS_VIP then strength = math.max(strength, MIN_SMOOTH) end
    local current = cam.CFrame.LookVector
    local newDir = current:Lerp(direction, strength)
    if newDir.Magnitude <= 0.001 then return end
    newDir = newDir.Unit
    cam.CFrame = CFrame.lookAt(cam.CFrame.Position, cam.CFrame.Position + newDir)
end

