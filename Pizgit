    local label = Instance.new("TextLabel", frame)
    label.Size = UDim2.new(1, -12, 0, 18)
    label.Position = UDim2.fromOffset(8, 3)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = Color3.fromRGB(220, 190, 255)
    label.TextSize = 11
    label.Font = Enum.Font.Gotham
    label.TextXAlignment = Enum.TextXAlignment.Left

    local btnRow = Instance.new("Frame", frame)
    btnRow.Size = UDim2.new(1, -12, 0, 26)
    btnRow.Position = UDim2.fromOffset(6, 24)
    btnRow.BackgroundTransparency = 1
    local rl = Instance.new("UIListLayout", btnRow)
    rl.FillDirection = Enum.FillDirection.Horizontal
    rl.Padding = UDim.new(0, 4)

    local buttons = {}
    local current = default

    local function refresh()
        for name, btn in pairs(buttons) do
            local active = (name == current)
            TweenService:Create(btn, TweenInfo.new(0.15), {
                BackgroundColor3 = active and PURPLE or Color3.fromRGB(50, 30, 70),
                TextColor3 = active and WHITE or Color3.fromRGB(180, 140, 230),
            }):Play()
        end
    end

    for _, opt in ipairs(options) do
        local btn = Instance.new("TextButton", btnRow)
        btn.Size = UDim2.new(0, opt.width or 75, 1, 0)
        btn.BackgroundColor3 = Color3.fromRGB(50, 30, 70)
        btn.Text = opt.label
        btn.TextColor3 = Color3.fromRGB(180, 140, 230)
        btn.TextSize = 10
        btn.Font = Enum.Font.GothamBold
        btn.BorderSizePixel = 0
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

        btn.MouseButton1Click:Connect(function()
            current = opt.value
            refresh()
            callback(opt.value)
        end)
        buttons[opt.value] = btn
    end
    refresh()
    return frame
end

