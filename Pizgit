    if KEY_EXPIRES then
        local left = KEY_EXPIRES - os.time()
        if left <= 0 then
            timerValue.Text = "ИСТЁК"
            timerValue.TextColor3 = Color3.fromRGB(255, 60, 60)
        else
            timerValue.Text = formatTime(left)
        end
    else
        timerValue.Text = "—"
    end
end

