local ESPData = {}

local function CreateESP(player)
    if player == LocalPlayer or ESPData[player] then return end

    -- Box
    local box = Drawing.new("Quad")
    box.Filled = false
    box.Thickness = 2
    box.Color = PURPLE
    box.Transparency = 1
    box.Visible = false

    -- Tracer
    local tracer = Drawing.new("Line")
    tracer.Thickness = 1
    tracer.Color = PURPLE
    tracer.Transparency = 0.8
    tracer.Visible = false

    -- Name
    local nameLabel = Drawing.new("Text")
    nameLabel.Size = 14; nameLabel.Center = true; nameLabel.Outline = true
    nameLabel.Color = WHITE; nameLabel.Visible = false

    -- Health text
    local healthLabel = Drawing.new("Text")
    healthLabel.Size = 12; healthLabel.Center = true; healthLabel.Outline = true
    healthLabel.Color = GREEN; healthLabel.Visible = false

    -- Distance
    local distLabel = Drawing.new("Text")
    distLabel.Size = 12; distLabel.Center = true; distLabel.Outline = true
    distLabel.Color = Color3.fromRGB(200, 180, 255); distLabel.Visible = false

    -- HP bar bg
    local hpBarBg = Drawing.new("Square")
    hpBarBg.Filled = true
    hpBarBg.Color = Color3.fromRGB(30, 10, 10)
    hpBarBg.Transparency = 0.5
    hpBarBg.Visible = false

    -- HP bar fill
    local hpBarFill = Drawing.new("Square")
    hpBarFill.Filled = true
    hpBarFill.Color = GREEN
    hpBarFill.Transparency = 1
    hpBarFill.Visible = false

    -- Skeleton lines (10 линий)
    local skeleton = {}
    for i = 1, 12 do
        local line = Drawing.new("Line")
        line.Thickness = 1.5
        line.Color = Color3.fromRGB(255, 100, 100)
        line.Transparency = 0.9
        line.Visible = false
        table.insert(skeleton, line)
    end

    ESPData[player] = {
        Box = box, Tracer = tracer, Name = nameLabel, Health = healthLabel,
        Distance = distLabel, HPBarBg = hpBarBg, HPBarFill = hpBarFill,
        Skeleton = skeleton,
    }

    -- Chams
    if Config.ESP.Chams then
        task.spawn(function()
            task.wait(0.5)
            local char = player.Character
            if char and not char:FindFirstChild("AlessiumCham") then
                local h = Instance.new("Highlight")
                h.Name = "AlessiumCham"
                h.FillColor = PURPLE
                h.OutlineColor = THEME.Light
                h.FillTransparency = 0.6
                h.OutlineTransparency = 0.2
                h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                h.Parent = char
            end
        end)
    end
end

local function RemoveESP(player)
    if ESPData[player] then
        for _, obj in pairs(ESPData[player]) do
            if typeof(obj) == "table" then
                for _, sub in pairs(obj) do
                    pcall(function() sub:Remove() end)
                end
            else
                pcall(function() obj:Remove() end)
            end
        end
        ESPData[player] = nil
    end
    local char = player.Character
    if char then
        local h = char:FindFirstChild("AlessiumCham")
        if h then h:Destroy() end
    end
end

