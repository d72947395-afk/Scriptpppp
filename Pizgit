local function GetHPColor(hum)
    local pct = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
    if pct < 0.5 then
        return Color3.fromRGB(255, 60, 60):Lerp(Color3.fromRGB(255, 220, 60), pct * 2)
    else
        return Color3.fromRGB(255, 220, 60):Lerp(Color3.fromRGB(60, 255, 90), (pct - 0.5) * 2)
    end
end

local function UpdateESP()
    for player, data in pairs(ESPData) do
        local hideAll = function()
            data.Box.Visible = false; data.Name.Visible = false
            data.Health.Visible = false; data.Ruby.Visible = false
            data.Distance.Visible = false; data.Tracer.Visible = false
            data.HPBarBg.Visible = false; data.HPBarFill.Visible = false
            data.Direction.Visible = false
        end

        if not player.Parent or not player.Character or not Config.ESP.Enabled then hideAll(); continue end
        local char = player.Character
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local head = char:FindFirstChild("Head")
        local hum = char:FindFirstChildOfClass("Humanoid")

        if not hrp or not hum or hum.Health <= 0 then hideAll(); continue end
        if Config.ESP.TeamCheck and player.Team and LocalPlayer.Team
            and player.Team == LocalPlayer.Team then hideAll(); continue end

        local distance = (hrp.Position - Camera.CFrame.Position).Magnitude
        if distance > Config.ESP.MaxDistance then hideAll(); continue end

        local topPos, onScreen = Camera:WorldToViewportPoint((head and head.Position or hrp.Position) + Vector3.new(0, 0.5, 0))
        local bottomPos = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))
        local screenCenter = Camera.ViewportSize / 2

        if onScreen then
            local height = math.abs(topPos.Y - bottomPos.Y)
            local width = height * 0.55
            local boxColor = Config.ESP.BoxColor
            if Config.ESP.HPColor then boxColor = GetHPColor(hum) end

            data.Box.PointA = Vector2.new(topPos.X - width/2, topPos.Y)
            data.Box.PointB = Vector2.new(topPos.X + width/2, topPos.Y)
            data.Box.PointC = Vector2.new(topPos.X + width/2, topPos.Y + height)
            data.Box.PointD = Vector2.new(topPos.X - width/2, topPos.Y + height)
            data.Box.Color = boxColor
            data.Box.Thickness = Config.ESP.BoxThickness
            data.Box.Visible = true

            if IS_VIP and Config.ESP.Tracers then
                local origin = Config.ESP.TracerOrigin == "Bottom"
                    and Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                    or UserInputService:GetMouseLocation()
                data.Tracer.From = origin
                data.Tracer.To = Vector2.new(topPos.X, topPos.Y + height/2)
                data.Tracer.Color = boxColor
                data.Tracer.Visible = true
            else data.Tracer.Visible = false end

            if Config.ESP.ShowName then
                data.Name.Text = player.Name
                data.Name.Position = Vector2.new(topPos.X, topPos.Y - 18)
                data.Name.Visible = true
            else data.Name.Visible = false end

            if Config.ESP.ShowHealth then
                data.Health.Text = string.format("❤ %d/%d", math.floor(hum.Health), math.floor(hum.MaxHealth))
                data.Health.Position = Vector2.new(topPos.X, topPos.Y + height + 3)
                data.Health.Visible = true
            else data.Health.Visible = false end

            if Config.ESP.ShowRuby then
                local ls = player:FindFirstChild("leaderstats")
                local val = ls and (ls:FindFirstChild("Rubies") or ls:FindFirstChild("Ruby")
                    or ls:FindFirstChild("Robux") or ls:FindFirstChild("Coins")
                    or ls:FindFirstChild("Cash") or ls:FindFirstChild("Money"))
                if val then
                    data.Ruby.Text = "💰 " .. tostring(val.Value)
                    data.Ruby.Position = Vector2.new(topPos.X, topPos.Y + height + 18)
                    data.Ruby.Visible = true
                else data.Ruby.Visible = false end
            else data.Ruby.Visible = false end

            if Config.ESP.ShowDistance then
                data.Distance.Text = string.format("[%d m]", math.floor(distance))
                data.Distance.Position = Vector2.new(topPos.X, topPos.Y + height + 33)
                data.Distance.Visible = true
            else data.Distance.Visible = false end
            
            -- HP BAR (ADMIN)
            if IS_ADMIN and Config.ESP.HPBars then
                local barWidth = width
                local barHeight = 4
                local barY = topPos.Y - 8
                local hpPct = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
                
                data.HPBarBg.Size = Vector2.new(barWidth, barHeight)
                data.HPBarBg.Position = Vector2.new(topPos.X - barWidth/2, barY)
                data.HPBarBg.Visible = true
                
                data.HPBarFill.Size = Vector2.new(barWidth * hpPct, barHeight)
                data.HPBarFill.Position = Vector2.new(topPos.X - barWidth/2, barY)
                data.HPBarFill.Color = GetHPColor(hum)
                data.HPBarFill.Visible = true
            else
                data.HPBarBg.Visible = false
                data.HPBarFill.Visible = false
            end
            
            -- DIRECTION (ADMIN) — стрелка за экраном
            if IS_ADMIN and Config.ESP.Direction then
                local dirX = topPos.X - screenCenter.X
                local dirY = topPos.Y - screenCenter.Y
                local angle = math.atan2(dirY, dirX)
                local edgeX = screenCenter.X + math.cos(angle) * (screenCenter.X * 0.85)
                local edgeY = screenCenter.Y + math.sin(angle) * (screenCenter.Y * 0.85)
                data.Direction.Text = "➤"
                data.Direction.Position = Vector2.new(edgeX, edgeY)
                data.Direction.Visible = true
            else
                data.Direction.Visible = false
            end
        else
            -- Всё равно показываем direction если админ
            if IS_ADMIN and Config.ESP.Direction then
                local dirX = topPos.X - screenCenter.X
                local dirY = topPos.Y - screenCenter.Y
                local angle = math.atan2(dirY, dirX)
                local edgeX = screenCenter.X + math.cos(angle) * (screenCenter.X * 0.85)
                local edgeY = screenCenter.Y + math.sin(angle) * (screenCenter.Y * 0.85)
                data.Direction.Text = "➤"
                data.Direction.Position = Vector2.new(edgeX, edgeY)
                data.Direction.Visible = true
            end
            data.Box.Visible = false
            data.Name.Visible = false
            data.Health.Visible = false
            data.Ruby.Visible = false
            data.Distance.Visible = false
            data.Tracer.Visible = false
            data.HPBarBg.Visible = false
            data.HPBarFill.Visible = false
        end
    end
end

