local function GetHPColor(hum)
    local pct = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
    if pct < 0.5 then
        return Color3.fromRGB(255, 60, 60):Lerp(Color3.fromRGB(255, 220, 60), pct * 2)
    else
        return Color3.fromRGB(255, 220, 60):Lerp(Color3.fromRGB(60, 255, 90), (pct - 0.5) * 2)
    end
end

local function UpdateSkeleton(data, char)
    for _, line in ipairs(data.Skeleton) do line.Visible = false end
    if not Config.ESP.Skeleton or not IS_VIP then return end

    local head = char:FindFirstChild("Head")
    local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
    local larm = char:FindFirstChild("LeftUpperArm") or char:FindFirstChild("Left Arm")
    local rarm = char:FindFirstChild("RightUpperArm") or char:FindFirstChild("Right Arm")
    local lleg = char:FindFirstChild("LeftUpperLeg") or char:FindFirstChild("Left Leg")
    local rleg = char:FindFirstChild("RightUpperLeg") or char:FindFirstChild("Right Leg")
    local lh = char:FindFirstChild("LeftHand") or char:FindFirstChild("Left Arm")
    local rh = char:FindFirstChild("RightHand") or char:FindFirstChild("Right Arm")
    local lf = char:FindFirstChild("LeftFoot") or char:FindFirstChild("Left Leg")
    local rf = char:FindFirstChild("RightFoot") or char:FindFirstChild("Right Leg")

    if not head or not torso then return end

    local points = {}
    local function add(p)
        if not p then return nil end
        local sp, os = Camera:WorldToViewportPoint(p.Position)
        if os and sp.Z > 0 then return Vector2.new(sp.X, sp.Y) end
        return nil
    end

    local hp = add(head)
    local tp = add(torso)
    local la = add(larm)
    local ra = add(rarm)
    local ll = add(lleg)
    local rl = add(rleg)
    local lhp = add(lh)
    local rhp = add(rh)
    local lfp = add(lf)
    local rfp = add(rf)

    local idx = 1
    local function drawLine(p1, p2)
        if not p1 or not p2 then return end
        if idx > #data.Skeleton then return end
        local line = data.Skeleton[idx]
        line.From = p1
        line.To = p2
        line.Visible = true
        idx = idx + 1
    end

    drawLine(hp, tp)
    drawLine(tp, la); drawLine(tp, ra)
    drawLine(la, lhp); drawLine(ra, rhp)
    drawLine(tp, ll); drawLine(tp, rl)
    drawLine(ll, lfp); drawLine(rl, rfp)
end

local function UpdateESP()
    local cam = Workspace.CurrentCamera
    if not cam then return end
    local viewport = cam.ViewportSize

    for player, data in pairs(ESPData) do
        local hideAll = function()
            data.Box.Visible = false
            data.Name.Visible = false
            data.Health.Visible = false
            data.Distance.Visible = false
            data.Tracer.Visible = false
            data.HPBarBg.Visible = false
            data.HPBarFill.Visible = false
            for _, line in ipairs(data.Skeleton) do line.Visible = false end
        end

        if not Config.ESP.Enabled or not player.Parent or not player.Character then
            hideAll(); continue
        end

        local char = player.Character
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local head = char:FindFirstChild("Head")
        local hum = char:FindFirstChildOfClass("Humanoid")

        if not hrp or not hum or hum.Health <= 0 then hideAll(); continue end
        if Config.ESP.TeamCheck and player.Team and LocalPlayer.Team
            and player.Team == LocalPlayer.Team then hideAll(); continue end

        local myChar = LocalPlayer.Character
        local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
        local distance = myRoot and (hrp.Position - myRoot.Position).Magnitude or 0
        if distance > Config.ESP.MaxDistance then hideAll(); continue end

        local topPos, onScreen = cam:WorldToViewportPoint((head and head.Position or hrp.Position) + Vector3.new(0, 0.5, 0))
        local bottomPos = cam:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))

        if onScreen then
            local height = math.abs(topPos.Y - bottomPos.Y)
            local width = height * 0.55

            data.Box.PointA = Vector2.new(topPos.X - width/2, topPos.Y)
            data.Box.PointB = Vector2.new(topPos.X + width/2, topPos.Y)
            data.Box.PointC = Vector2.new(topPos.X + width/2, topPos.Y + height)
            data.Box.PointD = Vector2.new(topPos.X - width/2, topPos.Y + height)
            data.Box.Color = PURPLE
            data.Box.Visible = Config.ESP.Box

            if IS_VIP and Config.ESP.Tracer then
                data.Tracer.From = Vector2.new(viewport.X / 2, viewport.Y)
                data.Tracer.To = Vector2.new(topPos.X, topPos.Y + height/2)
                data.Tracer.Color = PURPLE
                data.Tracer.Visible = true
            else
                data.Tracer.Visible = false
            end

            if Config.ESP.Name then
                data.Name.Text = player.DisplayName or player.Name
                data.Name.Position = Vector2.new(topPos.X, topPos.Y - 18)
                data.Name.Visible = true
            else data.Name.Visible = false end

            if Config.ESP.Health then
                data.Health.Text = string.format("❤ %d/%d", math.floor(hum.Health), math.floor(hum.MaxHealth))
                data.Health.Position = Vector2.new(topPos.X, topPos.Y + height + 3)
                data.Health.Visible = true
            else data.Health.Visible = false end

            if Config.ESP.Distance then
                data.Distance.Text = string.format("[%d m]", math.floor(distance))
                data.Distance.Position = Vector2.new(topPos.X, topPos.Y + height + 18)
                data.Distance.Visible = true
            else data.Distance.Visible = false end

            -- HP Bar (только VIP)
            if IS_VIP and Config.ESP.HPBars then
                local hpPct = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
                local barW = width
                local barH = 4
                local barY = topPos.Y - 8
                data.HPBarBg.Size = Vector2.new(barW, barH)
                data.HPBarBg.Position = Vector2.new(topPos.X - barW/2, barY)
                data.HPBarBg.Visible = true
                data.HPBarFill.Size = Vector2.new(barW * hpPct, barH)
                data.HPBarFill.Position = Vector2.new(topPos.X - barW/2, barY)
                data.HPBarFill.Color = GetHPColor(hum)
                data.HPBarFill.Visible = true
            else
                data.HPBarBg.Visible = false
                data.HPBarFill.Visible = false
            end

            -- Skeleton
            UpdateSkeleton(data, char)
        else
            hideAll()
        end
    end
end

