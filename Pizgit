-- MAIN LOOP
-- ============================================================
RunService.RenderStepped:Connect(function(dt)
    UpdateESP()

    if IS_VIP then
        if Config.Visual.XRay then
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character then
                    for _, part in ipairs(p.Character:GetDescendants()) do
                        if part:IsA("BasePart") then part.LocalTransparencyModifier = 0.5 end
                    end
                end
            end
        else
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character then
                    for _, part in ipairs(p.Character:GetDescendants()) do
                        if part:IsA("BasePart") and part.LocalTransparencyModifier ~= 0 then
                            part.LocalTransparencyModifier = 0
                        end
                    end
                end
            end
        end
    end

    if Config.Aim.ShowFOV then
        FOVCircle.Position = Config.Aim.Mode == "Mobile"
            and Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
            or UserInputService:GetMouseLocation()
        FOVCircle.Radius = Config.Aim.FOV
        FOVCircle.Visible = true
    else
        FOVCircle.Visible = false
    end

    local aimActive = false
    if Config.Aim.Enabled then
        if Config.Aim.Mode == "Mobile" and Config.Aim.MobileAutoAim then aimActive = true
        elseif Config.Aim.Mode == "Mobile" then aimActive = buttonAimActive
        elseif Config.Aim.Mode == "PC" then aimActive = keyAimActive
        elseif Config.Aim.Mode == "Both" then
            aimActive = keyAimActive or buttonAimActive
            if Config.Aim.MobileAutoAim and IS_MOBILE then aimActive = true end
        end
    end

    if aimActive then
        local target = GetTargetByPriority()
        if target then AimAt(target, dt) end
    end

    if IS_VIP and Config.Aim.Triggerbot and triggerKeyHeld and Config.Aim.Enabled then
        local refPos = Config.Aim.Mode == "Mobile"
            and Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
            or UserInputService:GetMouseLocation()
        for _, player in ipairs(Players:GetPlayers()) do
            if player == LocalPlayer or not player.Character then continue end
            local char = player.Character
            local part = char:FindFirstChild("Head")
            local hum = char:FindFirstChildOfClass("Humanoid")
            if not part or not hum or hum.Health <= 0 then continue end
            local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
            if not onScreen then continue end
            local d = (Vector2.new(screenPos.X, screenPos.Y) - refPos).Magnitude
            if d <= 40 then
                pcall(function()
                    VirtualInputManager:SendMouseButtonEvent(refPos.X, refPos.Y, 0, true, game, 1)
                    task.wait(0.01)
                    VirtualInputManager:SendMouseButtonEvent(refPos.X, refPos.Y, 0, false, game, 1)
                end)
                break
            end
        end
    end

    if MobileAimButton then
        MobileAimButton.Visible = (Config.Aim.Mode == "Mobile" or Config.Aim.Mode == "Both")
            and Config.Aim.ShowAimButton
    end
end)

