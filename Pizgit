end

local function downloadKeys()
    local req = (syn and syn.request) or (http and http.request) or http_request or request
    if not req then return nil end
    local ok, response = pcall(function()
        return req({ Url = KEYS_URL, Method = "GET" })
    end)
    if not ok or not response or not response.Body then return nil end
    return response.Body
end

local function parseKeys(content)
    local free, vip, admin = {}, {}, {}
    if not content then return free, vip, admin end
    for line in content:gmatch("[^\r\n]+") do
        line = line:gsub("^%s+", ""):gsub("%s+$", "")
        local keyType, list = line:match("^(%a+):(.+)$")
        if keyType and list then
            if keyType == "admin" then
                admin[list] = true
            else
                for num in list:gmatch("%d+") do
                    if keyType == "free" then free[num] = true
                    elseif keyType == "vip" then vip[num] = true end
                end
            end
        end
    end
    return free, vip, admin
end

local function checkKey(key, freeList, vipList, adminList)
    key = key:gsub("^%s+", ""):gsub("%s+$", "")
    if adminList and adminList[key] then
        return { type = "admin", label = "👑 ADMIN (все фишки)", key = key }
    end
    local num = key:match("%d+")
    if not num then return nil end
    if vipList[num] then return { type = "vip", label = "💎 VIP (бессрочный)", number = num } end
    if freeList[num] then return { type = "free", label = "🎁 Бесплатный (24ч)", number = num } end
    return nil
end

