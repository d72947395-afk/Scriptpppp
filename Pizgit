local function IsVisible(targetPart)
    local origin = Camera.CFrame.Position
    local ray = Ray.new(origin, (targetPart.Position - origin))
    local hit = Workspace:FindPartOnRayWithIgnoreList(ray, {
        LocalPlayer.Character, targetPart.Parent, Camera
    })
    return hit == nil
end

function GetTargetByPriority()
    local refPos = Config.Aim.Mode == "Mobile"
        and Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
        or UserInputService:GetMouseLocation()
    local best, bestScore = nil, math.huge

    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer or not player.Character then continue end
        local char = player.Character
        local part = char:FindFirstChild(Config.Aim.AimPart)
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not part or not hum or hum.Health <= 0 then continue end
        if Config.Aim.TeamCheck and player.Team and LocalPlayer.Team
            and player.Team == LocalPlayer.Team then continue end

        local worldDist = (part.Position - Camera.CFrame.Position).Magnitude
        if worldDist > Config.Aim.MaxDistance then continue end
        if Config.Aim.VisibleOnly and not IsVisible(part) then continue end

        local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
        if not onScreen then continue end
        local screenDist = (Vector2.new(screenPos.X, screenPos.Y) - refPos).Magnitude
        if screenDist > Config.Aim.FOV then continue end

        local score
        if Config.Aim.Priority == "LowHP" then score = hum.Health
        elseif Config.Aim.Priority == "Distance" then score = worldDist
        else score = screenDist end

        if score < bestScore then bestScore = score; best = player end
    end
    return best
end

local function AimAt(target, dt)
    if not target or not target.Character then return end
    local part = target.Character:FindFirstChild(Config.Aim.AimPart)
    if not part then return end
    local camPos = Camera.CFrame.Position
    local desired = (part.Position - camPos).Unit

    local smooth = Config.Aim.Smoothness
    if not IS_VIP then smooth = math.max(smooth, LIMITS.FREE_SMOOTH_MIN) end

    local halfLife = smooth * 3.0
    local alpha = halfLife <= 0.001 and 1 or (1 - 0.5 ^ (dt / halfLife))
    local newLook = Camera.CFrame.LookVector:Lerp(desired, alpha)
    Camera.CFrame = CFrame.new(camPos, camPos + newLook)
end

