    UpdateCameraAim()

    -- Aim Line
    if Config.Aim.ShowAimLine and Config.Aim.Enabled and _AlessiumAim.Target and _AlessiumAim.Target.Character then
        local cam = Workspace.CurrentCamera
        local part = GetTargetPart(_AlessiumAim.Target.Character)
        if part and cam then
            local sp, os = cam:WorldToViewportPoint(part.Position)
            if os and sp.Z > 0 then
                local center = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
                local dx, dy = sp.X - center.X, sp.Y - center.Y
                local len = math.sqrt(dx * dx + dy * dy)
                AimLine.Visible = true
                AimLine.Position = UDim2.fromOffset(center.X, center.Y)
                AimLine.Size = UDim2.fromOffset(len, 2)
                AimLine.Rotation = math.deg(math.atan2(dy, dx))
            else AimLine.Visible = false end
        else AimLine.Visible = false end
    else AimLine.Visible = false end

    -- FOV
    if Config.Aim.ShowFOV and Config.Aim.Enabled then
        FOVCircle.Visible = true
        FOVCircle.Size = UDim2.fromOffset(Config.Aim.FOV * 2, Config.Aim.FOV * 2)
    else FOVCircle.Visible = false end

    -- ESP
    if Config.ESP.Enabled then UpdateESP() end

    -- Hit Marker
    local cam2 = Workspace.CurrentCamera
    if cam2 then
        local center = Vector2.new(cam2.ViewportSize.X / 2, cam2.ViewportSize.Y / 2)
        if tick() - hitMarkerTime < 0.3 and Config.Visual.HitMarker and IS_VIP then
            local s = 12
            local positions = {
                {center.X - s, center.Y - s, center.X - 3, center.Y - 3},
                {center.X + 3, center.Y + 3, center.X + s, center.Y + s},
                {center.X + s, center.Y - s, center.X + 3, center.Y - 3},
                {center.X - 3, center.Y + 3, center.X - s, center.Y + s},
            }
            for i, p in ipairs(positions) do
                local f = hmFrames[i]
                local dx, dy = p[3] - p[1], p[4] - p[2]
                local len = math.sqrt(dx * dx + dy * dy)
                f.Position = UDim2.fromOffset(p[1], p[2])
                f.Size = UDim2.fromOffset(len, 2)
                f.Rotation = math.deg(math.atan2(dy, dx))
                f.Visible = true
            end
        else
            for _, f in ipairs(hmFrames) do f.Visible = false end
        end
    end

    Crosshair.Visible = Config.Visual.Crosshair and IS_VIP

    -- Triggerbot
    if IS_VIP and Config.Trigger.Enabled and triggerKeyHeld then
        local cam3 = Workspace.CurrentCamera
        if cam3 then
            local refPos = Vector2.new(cam3.ViewportSize.X / 2, cam3.ViewportSize.Y / 2)
            for _, player in ipairs(Players:GetPlayers()) do
                if player ~= LocalPlayer and player.Character then
                    local part = player.Character:FindFirstChild("Head")
                    local hum = player.Character:FindFirstChildOfClass("Humanoid")
                    if part and hum and hum.Health > 0 then
                        local sp, os = cam3:WorldToViewportPoint(part.Position)
                        if os then
                            local d = (Vector2.new(sp.X, sp.Y) - refPos).Magnitude
                            if d <= Config.Trigger.Range then
                                pcall(function()
                                    VirtualInputManager:SendMouseButtonEvent(refPos.X, refPos.Y, 0, true, game, 1)
                                    task.wait(Config.Trigger.Delay)
                                    VirtualInputManager:SendMouseButtonEvent(refPos.X, refPos.Y, 0, false, game, 1)
                                end)
                                break
                            end
                        end
                    end
                end
            end
        end
    end

    -- X-Ray
    if Config.Visual.XRay and IS_VIP and tick() - lastXRayUpdate > 0.2 then
        lastXRayUpdate = tick()
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                for _, part in ipairs(p.Character:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.LocalTransparencyModifier = 0.5
                    end
                end
            end
        end
    end

    -- Fly
    if Config.Move.Fly then
        local char = LocalPlayer.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            local root = char:FindFirstChild("HumanoidRootPart")
            if hum and root then
                pcall(function() hum.PlatformStand = true end)
                if not flyVelocity or not flyVelocity.Parent then
                    flyVelocity = Instance.new("BodyVelocity")
                    flyVelocity.Name = "AlessiumFly"
                    flyVelocity.MaxForce = Vector3.new(1e9, 1e9, 1e9)
                    flyVelocity.Velocity = Vector3.zero
                    flyVelocity.Parent = root
                end
                local md = hum.MoveDirection
                flyVelocity.Velocity = md.Magnitude > 0 and md * Config.Move.FlySpeed or Vector3.zero
            end
        end
    else
        if flyVelocity then
            pcall(function() flyVelocity:Destroy() end)
            flyVelocity = nil
        end
        local char = LocalPlayer.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then pcall(function() hum.PlatformStand = false end) end
        end
    end

    -- Noclip
    if Config.Move.Noclip then
        local char = LocalPlayer.Character
        if char then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") and part.CanCollide then
                    part.CanCollide = false
                end
            end
        end
    end

    -- Speed Hack
    if Config.Move.SpeedHack then
        local char = LocalPlayer.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then hum.WalkSpeed = Config.Move.SpeedValue end
        end
    end

    -- Bunny Hop
    if Config.Move.BunnyHop then
        local char = LocalPlayer.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then
                if hum.MoveDirection.Magnitude < 0.1 then
                    if hum.WalkSpeed > 16 then hum.WalkSpeed = 16 end
                else
                    hum.WalkSpeed = Config.Move.BHopSpeed
                    local state = hum:GetState()
                    if state == Enum.HumanoidStateType.Running
                    or state == Enum.HumanoidStateType.Jumping
                    or state == Enum.HumanoidStateType.Freefall then
                        hum.JumpPower = 50
                        hum:ChangeState(Enum.HumanoidStateType.Jumping)
                    end
                end
            end
        end
    end

    -- Rainbow
    if Config.Troll.Rainbow then
        local char = LocalPlayer.Character
        if char then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                    pcall(function()
                        part.Color = Color3.fromHSV((tick() * 0.3) % 1, 1, 1)
                    end)
                end
            end
        end
    end

    -- Fire Aura
    if Config.Troll.FireAura then
        local char = LocalPlayer.Character
        if char then
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hrp and not hrp:FindFirstChild("AlessiumFire") then
                local fire = Instance.new("Fire", hrp)
                fire.Name = "AlessiumFire"
                fire.Size = 12
                fire.Heat = 15
                fire.Color = Color3.fromRGB(255, 100, 0)
                fire.SecondaryColor = Color3.fromRGB(255, 200, 50)
            end
        end
    else
        local char = LocalPlayer.Character
        if char then
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hrp then
                local f = hrp:FindFirstChild("AlessiumFire")
                if f then f:Destroy() end
            end
        end
    end

    -- Spin Bot
    if IS_ADMIN and Config.Troll.SpinBot then
        local char = LocalPlayer.Character
        if char then
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hrp then
                pcall(function()
                    hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(15), 0)
                end)
            end
        end
    end

    -- Admin Badge re-apply
    if IS_ADMIN and Config.Troll.AdminBadge then
        local char = LocalPlayer.Character
        if char then
            local head = char:FindFirstChild("Head")
            if head and not head:FindFirstChild("AdminBadge") then
                applyAdminBadge(true)
            end
        end
    end

    -- Mobile Button visibility
    frameCounter = frameCounter + 1
    if frameCounter % 10 == 0 then
        MobileAimButton.Visible = (Config.Aim.Mode == "Mobile" or Config.Aim.Mode == "Both") and IS_MOBILE
    end

    -- FPS
    if fpsTimeAccum >= 0.5 then
        local fps = math.floor(fpsCounter / fpsTimeAccum + 0.5)
        local color = Color3.fromRGB(100, 255, 130)
        if fps < 50 then color = Color3.fromRGB(255, 220, 60) end
        if fps < 30 then color = Color3.fromRGB(255, 80, 80) end
        WmFPS.Text = ("FPS: %d"):format(fps)
        WmFPS.TextColor3 = color
        fpsCounter = 0
        fpsTimeAccum = 0
    end

    -- Ping
    if tick() - lastPingUpdate > 1 then
        lastPingUpdate = tick()
        task.spawn(function()
            local ok, ping = pcall(function() return LocalPlayer:GetNetworkPing() * 1000 end)
            if ok and ping and ping > 0 then
                local color = Color3.fromRGB(100, 255, 130)
                if ping > 150 then color = Color3.fromRGB(255, 220, 60) end
                if ping > 300 then color = Color3.fromRGB(255, 80, 80) end
                WmPing.Text = ("Ping: %d ms"):format(math.floor(ping))
                WmPing.TextColor3 = color
            end
        end)
    end

    -- Auto Respawn
    if Config.Misc.AutoRespawn then
        local char = LocalPlayer.Character
        if not char then
            pcall(function() LocalPlayer:LoadCharacter() end)
        else
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health <= 0 then
                task.wait(0.3)
                pcall(function() LocalPlayer:LoadCharacter() end)
            end
        end
    end

    -- Kill Sound
    if IS_VIP and Config.Misc.KillSound and tick() - lastKillCheck > 0.5 then
        lastKillCheck = tick()
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                local hum = p.Character:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health <= 0 then
                    local s = Instance.new("Sound", SoundService)
                    s.SoundId = "rbxassetid://5793470411"
                    s.Volume = 1
                    s:Play()
                    task.delay(3, function() if s then s:Destroy() end end)
                end
            end
        end
    end
end)

