    if decodeOk then return data end
    return nil
end

local FREE_COOLDOWN_HOURS = 24

local function loadUsedKeys()
    local ok, content = pcall(function()
        if isfile and isfile("AlessiumUsedKeys.txt") then return readfile("AlessiumUsedKeys.txt") end
    end)
    if not ok or not content then return {} end
    local d, data = pcall(function() return _HS:JSONDecode(content) end)
    if d and type(data) == "table" then return data end
    return {}
end

local function saveUsedKeys(used)
    pcall(function() if writefile then writefile("AlessiumUsedKeys.txt", _HS:JSONEncode(used)) end end)
end

local function isKeyUsedOnThisHWID(key, hwid)
    local used = loadUsedKeys()
    local hwidUsed = used[hwid]
    if not hwidUsed then return false, 0 end
    for _, entry in ipairs(hwidUsed) do
        if entry.key == key then
            local hoursPassed = (os.time() - entry.time) / 3600
            if hoursPassed < FREE_COOLDOWN_HOURS then
                return true, FREE_COOLDOWN_HOURS - hoursPassed
            end
            return false, 0
        end
    end
    return false, 0
end

local function markKeyUsed(key, hwid)
    local used = loadUsedKeys()
    if not used[hwid] then used[hwid] = {} end
    for _, entry in ipairs(used[hwid]) do
        if entry.key == key then entry.time = os.time(); saveUsedKeys(used); return end
    end
    table.insert(used[hwid], { key = key, time = os.time() })
    saveUsedKeys(used)
end

